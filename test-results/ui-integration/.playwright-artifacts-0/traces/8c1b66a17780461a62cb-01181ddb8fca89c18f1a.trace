ff,#a85cff) border-box}\n.scr{position:absolute;inset:0;animation:in .45s var(--e);background:radial-gradient(circle at 100% 0,rgba(59,139,255,.13),transparent 45%),linear-gradient(#fff,#f6f9ff)}\n@keyframes in{from{opacity:0;transform:translateY(8px)}}\n.abs{position:absolute}\n.logo{display:flex;gap:9px;align-items:center;font-weight:800;font-size:20px}.logo i{width:26px;height:26px;border-radius:8px;background:var(--b1);display:grid;place-items:center}.logo i:after{content:\"\";width:8px;height:8px;border-radius:50%;background:#fff}.logo b{color:var(--b2);font-weight:800}\n.av{width:44px;height:44px;border-radius:50%;background:#e6edfb;color:var(--b1);font-weight:800;font-size:14px;display:grid;place-items:center}\n.sq{width:44px;height:44px;border-radius:14px;background:#fff;border:1px solid var(--bd);display:grid;place-items:center;color:var(--b1);box-shadow:0 2px 8px rgba(37,99,255,.08)}\n.tr{position:absolute;top:16px;right:20px;display:flex;gap:10px}\n.pill{height:62px;border-radius:20px;padding:0 28px;font-size:20px;font-weight:800;display:inline-flex;gap:12px;align-items:center;justify-content:center;background:linear-gradient(180deg,#4d8bff,var(--b1));color:#fff;box-shadow:0 3px 0 #1a46c9,0 12px 26px rgba(37,99,255,.32);transition:transform .15s var(--e)}\n.pill:active{transform:translateY(2px)}.pill[disabled]{background:#d6dcea;box-shadow:0 3px 0 #bcc4d6;cursor:default}\n.pill.w{background:#fff;color:var(--ink);box-shadow:0 2px 0 var(--bd),0 8px 20px rgba(37,99,255,.1);border:1px solid var(--bd)}\n.bk{display:flex;gap:10px;align-items:center;font-size:16px;font-weight:700;color:var(--mut);min-height:62px;padding:0 10px}\n.wm{font-size:120px;font-weight:900;letter-spacing:-.05em;line-height:1}.wm b{color:var(--b1);font-weight:900}\n.card{background:#fff;border:1px solid var(--bd);border-radius:30px;box-shadow:0 14px 40px rgba(37,99,255,.08)}\n/* orb */\n.ow{position:absolute;left:50%;bottom:26px;width:160px;margin-left:-80px;display:flex;flex-direction:co