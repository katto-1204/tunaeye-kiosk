or:var(--mut);border:1px solid var(--bd)}.chip.ok{background:var(--okt);color:var(--ok);border-color:#bfead6}.chip.er{background:#fdecea;color:var(--er);border-color:#f5c6c1}\n.rng{width:500px;height:12px;border-radius:9px;background:#eef2fc;position:relative;margin-top:22px;overflow:visible}.rng u{position:absolute;top:0;bottom:0;border-radius:9px;background:linear-gradient(90deg,#9db8ff,#d6e2ff)}.rng i{position:absolute;top:-8px;width:6px;height:28px;border-radius:4px;background:var(--b1);transition:left .3s var(--e)}\n.kp{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;width:350px}\n.kp button{height:62px;border-radius:16px;background:#fff;border:1px solid var(--bd);box-shadow:0 3px 0 var(--bd);font-size:26px;font-weight:800;display:grid;place-items:center}.kp button:active{transform:translateY(2px);box-shadow:none}.kp .del{background:#fff3f1;color:var(--er);border-color:#fbd5d0}.kp .cl{grid-column:1/-1;height:48px;font-size:16px;color:var(--mut)}\n/* name */\n.inp{width:100%;height:92px;border-radius:26px;border:2px solid var(--b2);box-shadow:0 0 0 8px rgba(59,139,255,.15);font:800 36px Inter;color:var(--ink);padding:0 28px;outline:0;background:#fff}\n.rem{display:flex;gap:12px;align-items:center;font-size:17px;color:var(--mut);min-height:62px;cursor:pointer}.rem i{width:28px;height:28px;border-radius:9px;border:2px solid var(--bd);display:grid;place-items:center;color:#fff;font-style:normal}.rem i.on{background:var(--b1);border-color:var(--b1)}\n.lk{display:flex;gap:20px;font-size:14px}.lk a{color:var(--b1);font-weight:600;text-decoration:underline}\n/* capture */\n.vf{position:relative;overflow:hidden;border-radius:30px;background:linear-gradient(145deg,#fbfcff,#e8effd);border:1px solid var(--bd)}\n.gd{position:absolute;inset:60px 80px;border:1px dashed #9db8ee}\n.br{position:absolute;width:44px;height:44px;border:5px solid var(--b1);filter:drop-shadow(0 0 6px rgba(37,99,255,.6))}\n.br.a{left:70px;top:50px;border-right:0;border-bottom:0;border-radius:14px 0 0 0}.br.b{right:70px;top:50px;border-left:0;border-bottom:0;border-radius:0 14px 0 0}.br.c{left:70px;bottom:50px;border-right:0;border-top:0;border-radius:0 0 0 14px}.br.d{right:70px;bottom:50px;border-left:0;border-top:0;border-radius:0 0 14px 0}\n.scan{position:absolute;left:50px;right:50px;top:40px;height:3px;background:var(--b1);box-shadow:0 0 20px 6px rgba(37,99,255,.45);animation:scan 2.6s ease-in-out infinite alternate}@keyframes scan{to{transform:translateY(290px)}}\n.chs{position:absolute;left:18px;top:16px;display:flex;gap:8px;z-index:2}.chs span{background:#fff;border-radius:99px;padding:6px 16px;font-size:14px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,.08)}.chs .g{color:var(--ok)}.chs .g:before{content:\"● \"}\n.fl{position:absolute;inset:0;background:#fff;z-index:20;pointer-events:none;animation:fl .38s ease-out forwards}@keyframes fl{from{opacity:1}to{opacity:0}}\n.bar{position:absolute;left:60px;right:60px;bottom:18px;height:70px;border-radius:24px;background:#fff;border:1px solid var(--bd);box-shadow:0 10px 30px rgba(37,99,255,.08);display:flex;align-items:center;padding:0 14px}\n.bar .pill{height:50px;font-size:18px;border-radius:16px}\n/* dials */\n.st{padding:12px 14px!important;gap:10px!important}.st u{width:38px!important;height:38px!important;flex:none}.st small{line-height:1.25}.dial{position:relative;display:grid;place-items:center}.dial>svg{transform:rotate(-90deg)}.dial .v{position:absolute;font-weight:900;letter-spacing:-.03em}.dial .f{transition:stroke-dasharray .9s var(--e)}\n.vs{padding:12px 26px;border-radius:20px;background:var(--okt);border:1px solid #bfead6;color:#0b7a4f;display:flex;justify-content:space-between;align-items:center}.vs b{font-weight:900}.vs small{font-size:14px;font-weight:700;text-align:right;line-height:1.3}\n.gt{width:210px;height:210px;border-radius:56px;display:grid;place-items:center;font-size:150px;font-weight:900;color:#4a2c00;animation:pop .6s var(--e)}@keyframes pop{from{transform:scale(.7);opacity:0}}\n.seg{display:flex;gap:8px;position:absolute;top:16px;left:50%;margin-left:-125px}.seg i{width:54px;height:6px;border-radius:4px;background:#e3eaf8;margin-top:6px}.seg i.d{background:var(--ok)}.seg i.c{background:var(--b1);height:44px;margin:-13px 0 0;border-radius:12px;width:62px;box-shadow:0 0 0 4px #e0e9ff}\n/* receipt */\n.pr{width:300px;position:relative}.ph{height:44px;border-radius:16px;background:#0b1630;position:relative;z-index:3;box-shadow:0 12px 20px rgba(11,22,48,.25);color:#7c8aa8;font:11px \"Courier New\",monospace;padding:14px 14px}.ph b{float:right;color:#2ee6a0;font-weight:400}\n.pa{background:#fffdf8;margin:-6px 20px 0;padding:22px 18px 30px;font:13px \"Courier New\",monospace;filter:drop-shadow(0 10px 8px rgba(0,0,0,.15));clip-path:polygon(0 0,100% 0,100% 100%,95% 97%,90% 100%,85% 97%,80% 100%,75% 97%,70% 100%,65% 97%,60% 100%,55% 97%,50% 100%,45% 97%,40% 100%,35% 97%,30% 100%,25% 97%,20% 100%,15% 97%,10% 100%,5% 97%,0 100%);animation:feed 1.2s var(--e)}@keyframes feed{from{transform:translateY(-110%)}}\n.pa p{display:flex;justify-content:space-between;padding:3px 0}.pa hr{border:0;border-top:1px dashed #ccc;margin:8px 0}.pa h4{text-align:center;font-size:14px}.pa em{display:block;font-size:11px;color:#999;font-style:italic}\n.chk{width:170px;height:170px;border-radius:50%;background:var(--okt);display:grid;place-items:center;position:relative;border:2px solid #bfead6}.chk i{position:absolute;inset:0;border-radius:50%;border:2px solid var(--ok);animation:pulse 2s var(--e) infinite}.chk i+i{animation-delay:1s}.chk path{stroke-dasharray:60;stroke-dashoffset:60;animation:dr .7s .2s var(--e) forwards}@keyframes dr{to{stroke-dashoffset:0}}\n/* dash */\n.st{padding:16px 18px;display:flex;gap:14px;align-items:center;border-radius:22px;background:#fff;border:1px solid var(--bd)}.st u{width:44px;height:44px;border-radius:14px;background:#eaf0ff;color:var(--b1);display:grid;place-items:center}.st small{font-size:14px;color:var(--mut);display:block}.st b{font-size:30px;font-weight:900;display:block;line-height:1.1}\ntable{width:100%;border-collapse:collapse}th{font-size:14px;color:var(--mut);font-weight:600;text-align:left;padding:10px 6px;letter-spacing:.04em}td{padding:11px 6px;border-top:1px solid var(--bd);font-size:15px;font-weight:700}tr.r{cursor:pointer}tr.r:hover{background:var(--pn)}\n.tg{font-size:12px;font-weight:700;padding:2px 8px;border-radius:6px;background:var(--pn);color:var(--mut)}.tg.s{background:var(--okt);color:var(--ok)}\n.gb{width:36px;height:36px;border-radius:50%;background:var(--okt);color:var(--ok);display:grid;place-items:center;font-weight:900}.cp{padding:8px 16px;border-radius:99px;background:var(--okt);color:var(--ok);font-weight:800}\n\n/* ===== POLISH ===== */\nhtml{-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent;text-rendering:optimizeLegibility}\nbody{user-select:none;-webkit-user-select:none;touch-action:manipulation;overscroll-behavior:none}\ninput{user-select:text;-webkit-user-select:text}\n::selection{background:#cfe0ff}\nbutton{transition:transform .18s var(--e),box-shadow .2s var(--e),background .2s,color .2s,opacity .2s;appearance:none;-webkit-appearance:none}\nbutton:focus-visible,input:focus-visible,tr.r:focus-visible,.half:focus-visible{outline:3px solid var(--b2);outline-offset:3px}\nbutton[disabled]{cursor:not-allowed}\n.scr>*{animation:rise .6s var(--e) backwards}\n.scr>*:nth-child(2){animation-delay:.04s}.scr>*:nth-child(3){animation-delay:.08s}.scr>*:nth-child(4){animation-delay:.12s}.scr>*:nth-child(5){animation-delay:.16s}.scr>*:nth-child(n+6){animation-delay:.2s}\n@keyframes rise{from{opacity:0;transform:translateY(14px)}}@keyframes fade{from{opacity:0}}\n.card{box-shadow:0 1px 0 #fff inset,0 2px 4px rgba(11,22,48,.03),0 24px 56px -12px rgba(37,99,255,.14)}\n.pill{letter-spacing:-.01em;position:relative;overflow:hidden}\n.pill:not([disabled]):hover{transform:translateY(-2px);box-shadow:0 5px 0 #1a46c9,0 18px 34px rgba(37,99,255,.38)}.pill.w:not([disabled]):hover{box-shadow:0 4px 0 var(--bd),0 14px 28px rgba(37,99,255,.14)}\n.pill:not([disabled]):active{transform:translateY(2px) scale(.985);box-shadow:0 1px 0 #1a46c9,0 6px 14px rgba(37,99,255,.3)}\n.pill:not(.w):not([disabled]):before{content:\"\";position:absolute;inset:0 0 50%;background:linear-gradient(rgba(255,255,255,.28),transparent);pointer-events:none}\n.sq:hover,.sb:hover span{transform:translateY(-2px);box-shadow:0 10px 22px rgba(37,99,255,.18)}.sb:active span,.sq:active{transform:scale(.92)}\n.bk:hover{color:var(--ink)}.bk:active{transform:scale(.96)}\n.kp button:hover{border-color:#c4d4fb;background:#fafcff}.kp button:active{background:#eaf0ff}\n.half:hover{filter:brightness(.98)}.half:hover .tile{transform:scale(1.06)}.half:active{filter:brightness(.94)}.tile{transition:transform .3s var(--e)}\ntr.r{transition:background .15s}tr.r:active{background:#eaf0ff}\n.inp{transition:box-shadow .25s var(--e),border-color .25s}.inp::placeholder{color:#b9c3dc}\n.chip{transition:all .25s var(--e)}.big{transition:color .2s,transform .15s var(--e)}\n.rng u{transition:width .3s var(--e)}\n.spin{width:22px;height:22px;border-radius:50%;border:3px solid rgba(255,255,255,.4);border-top-color:#fff;animation:sp .7s linear infinite}@keyframes sp{to{transform:rotate(360deg)}}\n.pill.busy{pointer-events:none;opacity:.9}\n.toast{position:absolute;left:50%;top:18px;transform:translateX(-50%);z-index:60;background:#0b1630;color:#fff;padding:14px 22px;border-radius:16px;font-size:16px;font-weight:700;box-shadow:0 14px 34px rgba(11,22,48,.3);animation:tin .35s var(--e);display:flex;gap:10px;align-items:center}.toast.er{background:var(--er)}\n@keyframes tin{from{opacity:0;transform:translate(-50%,-14px)}}\n.ovl{position:absolute;inset:0;z-index:50;background:rgba(11,22,48,.35);backdrop-filter:blur(6px);display:grid;place-items:center;animation:fade .25s}\n.sheet{width:480px;background:#fff;border-radius:32px;padding:32px;box-shadow:0 30px 80px rgba(11,22,48,.35);animation:rise .4s var(--e)}\n.sheet h2{font-size:30px;font-weight:900;letter-spacing:-.03em}.sheet .g3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:22px 0}\n.gopt{height:110px;border-radius:24px;border:2px solid var(--bd);font-size:56px;font-weight:900;background:#fff}.gopt:hover{border-color:var(--b2);background:#f4f8ff}.gopt.on{border-color:var(--b1);background:#eaf0ff;color:var(--b1)}\n.gopt:active{transform:scale(.96)}\n\n/* ===== PWA / TABLET ===== */\nhtml.bluebg,html.bluebg body{background:linear-gradient(#0a4a9a,#031a45)}\nhtml,body{background:#fff;position:fixed;inset:0;width:100%;height:100dvh;-webkit-touch-callout:none}\nbody{padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}\n#stage{box-shadow:0 30px 80px rgba(11,40,120,.3);will-change:transform}\n#rot{display:none;position:fixed;inset:0;z-index:999;background:#fff;flex-direction:column;align-items:center;justify-content:center;gap:22px;font:900 34px Inter,sans-serif;letter-spacing:-.02em;color:#0b1630}\n@media (orientation:portrait) and (max-aspect-ratio:9/10){#rot{display:flex}}\n.rotic{animation:rotp 2.6s ease-in-out infinite}@keyframes rotp{0%,25%{transform:rotate(0)}65%,100%{transform:rotate(-90deg)}}\n@media (display-mode:fullscreen),(display-mode:standalone){#stage{border-radius:26px}}\n/* ===== BLUE GRADIENT + MOTION ===== */\n.scr.blue{background:radial-gradient(ellipse at 50% 46%,rgba(2,22,64,.5),transparent 62%),url(data:image/jpeg;base64,) center 38%/cover,#0a4a9a}\n.scr>.fx{animation:none}\n.fx{position:absolute;inset:0;overflow:hidden;pointer-events:none;background:radial-gradient(circle at 100% 100%,rgba(255,255,255,.18),transparent 45%)}\n.fx:before{content:\"\";position:absolute;width:560px;height:560px;left:-140px;top:-190px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.7),transparent 70%);animation:drift 14s ease-in-out infinite alternate}\n@keyframes drift{to{transform:tr