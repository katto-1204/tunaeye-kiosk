med5{justify-content:center;padding:16px 28px;gap:0}\n.med5:before{display:none}\n.med5-b{width:160px;height:160px;flex:none}.med5.two .med5-b{width:136px;height:136px}\n.med5-b:before{display:none}\n.med5-r{filter:none}\n.med5-l{font-size:98px}.med5.two .med5-l{font-size:84px}\n.gt5{font-size:34px;margin-top:10px;text-align:center}.med5.two .gt5{font-size:30px;margin-top:6px}\n.gs5{font-size:17px;text-align:center}\n.sp5{position:relative;display:inline-flex;align-items:center;gap:10px;margin-top:12px;padding:6px 6px 6px 16px;border-radius:99px;background:#fff;border:1px solid rgba(11,26,58,.08);box-shadow:0 10px 24px -12px rgba(37,99,255,.35);font-size:13px;font-weight:700;color:var(--mut);animation:rise .6s .5s var(--e) backwards}\n.sp5 b{padding:5px 14px;border-radius:99px;background:linear-gradient(135deg,var(--ga),var(--gb));color:#3a2600;font-size:18px;font-weight:900;letter-spacing:-.02em}\n.bs5{margin-top:18px;padding-top:16px;width:100%;border-top:1px solid rgba(11,26,58,.08);gap:14px}\n.lg5{position:relative;display:flex;justify-content:center;gap:16px;margin-top:12px;font-size:12px;font-weight:700;color:var(--mut)}.med5.two .lg5{display:none}\n.lg5 i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px}\n.lg5{text-align:center;overflow-wrap:anywhere}\n.name-tools{position:absolute;left:60px;bottom:26px;width:520px;display:flex;align-items:center;flex-wrap:wrap;gap:10px}\n.name-tools>#dmc{flex:0 1 310px;min-width:0}\n.name-tools>#te-test-print-btn{flex:0 1 auto;min-width:0;max-width:200px;overflow-wrap:anywhere}\n.name-tools>select{flex-basis:100%}\n\n/* ===================================================================\n   REDESIGN: welcome (landing look), dashboard, receipt\n   =================================================================== */\n\n/* ---------- WELCOME: landing-page look on the photo background ---------- */\n.scr>.wl-shade{animation:none;position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(2,18,60,.36),rgba(2,18,60,0) 26%,rgba(2,18,60,0) 56%,rgba(2,18,60,.58))}\n.wl-nav{position:absolute;left:14px;right:14px;top:14px;max-width:1072px;margin:0 auto;height:62px;z-index:3;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 9px;border-radius:99px;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.4);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);box-shadow:0 12px 40px rgba(10,40,120,.22);color:#fff}\n.wl-brand{display:flex;align-items:center;gap:9px;font-size:20px;font-weight:600;letter-spacing:-.03em}\n.wl-brand svg{width:28px;height:28px}.wl-brand em{font-style:normal;color:#a9d6ff}\n.wl-nr{display:flex;gap:6px;align-items:center;justify-self:end}\n.wl-nav>.wl-b{justify-self:start}\n.wl-b{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:99px;font-size:14px;font-weight:500;color:#fff;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.28)}\n.wl-i{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;color:#fff;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.28)}\n.wl-b:hover,.wl-i:hover{background:rgba(255,255,255,.3)}.wl-b:active,.wl-i:active{transform:scale(.94)}\n.wl-hero{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:84px 40px 80px;color:#fff}\n.wl-pill{display:inline-flex;align-items:center;gap:9px;padding:8px 16px;border-radius:99px;background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.45);font-size:14px;font-weight:500;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}\n.wl-pill i{width:8px;height:8px;border-radius:50%;background:#7dffb0;animation:wlpu 1.8s infinite}\n@keyframes wlpu{0%{box-shadow:0 0 0 0 rgba(125,255,176,.7)}50%{box-shadow:0 0 0 7px rgba(125,255,176,0)}}\n.wl-hero h1{margin:20px 0 12px;font-size:158px;font-weight:300;line-height:.96;letter-spacing:-.055em;text-shadow:0 10px 40px rgba(5,30,110,.35)}\n.wl-w{display:block;overflow:hidden;padding:0 .08em .1em}\n.wl-w>span{display:inline-block;transform:translateY(105%);animation:wlup .95s var(--e) .12s forwards}\n@keyframes wlup{to{transform:none}}\n.wl-s{font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.035em}\n.wl-q{font-size:25px;font-weight:400;letter-spacing:-.015em;text-shadow:0 2px 16px rgba(0,30,90,.5)}\n.wl-sp{margin-top:8px;font-size:17px;font-weight:300;opacity:.92;text-shadow:0 2px 12px rgba(0,30,90,.45)}\n.wl-cta{margin-top:34px;height:78px;padding:0 13px 0 40px;border-radius:99px;display:inline-flex;align-items:center;gap:26px;background:#fff;color:var(--ink);font-size:26px;font-weight:600;letter-spacing:-.02em;box-shadow:0 20px 50px rgba(5,30,110,.4);transition:transform .25s var(--e),box-shadow .25s}\n.wl-cta:hover{transform:translateY(-3px);box-shadow:0 26px 60px rgba(5,30,110,.46)}.wl-cta:active{transform:scale(.97)}\n.wl-cta i{position:relative;width:52px;height:52px;border-radius:50%;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,#3b8bff,#0b45e5);box-shadow:0 8px 20px rgba(11,69,229,.45)}\n.wl-cta i:after{content:\"\";position:absolute;inset:0;border-radius:50%;border:2px solid #3b8bff;animation:pulse 2.4s var(--e) infinite}\n.wl-band{position:absolute;left:14px;right:14px;bottom:16px;z-index:3;display:flex;justify-content:center;gap:10px}\n.wl-band span{display:inline-flex;align-items:center;gap:10px;height:46px;padding:0 20px 0 8px;border-radius:99px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.32);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);font-size:14px;font-weight:500;color:#fff;white-space:nowrap}\n.wl-band b{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#fff;color:#0a45d8;font-size:12px;font-weight:700}\n\n/* ---------- DASHBOARD ---------- */\n.dsh{position:absolute;left:30px;right:30px;top:26px;bottom:88px;display:flex;gap:20px}\n.dsl{width:384px;flex:none;display:flex;flex-direction:column;gap:14px;min-height:0}\n.dhero{position:relative;overflow:hidden;flex:1 0 auto;display:flex;flex-direction:column;justify-content:center;border-radius:34px;padding:24px 28px 24px;color:#fff;background:radial-gradient(420px 260px at 100% 0,rgba(255,255,255,.3),transparent 62%),radial-gradient(380px 260px at 0 100%,rgba(125,183,251,.45),transparent 60%),linear-gradient(165deg,#0a3cc4 0%,#1b6cf0 58%,#3d8cf3 100%);box-shadow:0 34px 60px -28px rgba(10,60,200,.65);animation:rise .6s var(--e) backwards}\n.dhero:before{content:\"\";position:absolute;width:300px;height:180px;right:-90px;top:-50px;border-radius:50%;background:radial-gradient(closest-side,rgba(255,255,255,.55),transparent);filter:blur(10px);animation:ltd 16s ease-in-out infinite alternate;pointer-events:none}\n.dhero>*{position:relative}\n.dhero .wl-pill{align-self:flex-start;font-size:13px;padding:6px 14px}\n.dwel{margin-top:16px;font-size:19px;font-weight:300;opacity:.92}\n.dname{font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.02em;line-height:1.02;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-bottom:.06em;text-shadow:0 8px 30px rgba(5,30,110,.3)}\n.dgo{margin-top:16px;width:100%;height:60px;border-radius:99px;background:#fff;color:var(--ink);font-size:21px;font-weight:600;letter-spacing:-.02em;display:flex;align-items:center;justify-content:space-between;padding:0 8px 0 26px;box-shadow:0 14px 30px -10px rgba(3,21,80,.5)}\n.dgo:hover{transform:translateY(-2px)}.dgo:active{transform:scale(.98)}\n.dgo i{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#3b8bff,#0b45e5);color:#fff;display:grid;place-items:center}\n.dsec{display:flex;gap:10px;margin-top:10px}\n.dsy,.dlo{flex:1;height:48px;border-radius:99px;font-size:16px;font-weight:600;display:flex;gap:8px;align-items:center;justify-content:center;white-space:nowr